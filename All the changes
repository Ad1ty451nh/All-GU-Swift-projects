//
//  AppIntent.swift
//  DrPawWidget
//
//  FIX (24/09/26): Pause/Resume/Stop for the Pet Time Live Activity were
//  conforming to plain `AppIntent`. That's correct for the ordinary
//  WidgetKit widget buttons (Food/Walk) below, but buttons attached to a
//  Live Activity (Dynamic Island / Lock Screen) need `LiveActivityIntent`
//  instead — without it, the system isn't guaranteed to actually run
//  perform() when tapped from those surfaces, which is why the countdown
//  kept ticking regardless of what was tapped. LiveActivityIntent is a
//  pure marker protocol on top of AppIntent, so no other code changes.
//

import AppIntents
import ActivityKit
import WidgetKit

struct PetEntity: AppEntity, Hashable {
    let id: String
    let name: String

    static var typeDisplayRepresentation: TypeDisplayRepresentation {
        "Pet"
    }

    var displayRepresentation: DisplayRepresentation {
        DisplayRepresentation(title: "\(name)")
    }

    static var defaultQuery = PetQuery()
}

struct PetQuery: EntityQuery {
    func entities(for identifiers: [PetEntity.ID]) async throws -> [PetEntity] {
        WidgetSharedStore.loadPets()
            .filter { identifiers.contains($0.id) }
            .map { PetEntity(id: $0.id, name: $0.name) }
    }

    func suggestedEntities() async throws -> [PetEntity] {
        let pets = WidgetSharedStore.loadPets()
        if pets.isEmpty {
            return [PetEntity(id: "placeholder", name: "Add a pet in Dr. Paws")]
        }
        return pets.map { PetEntity(id: $0.id, name: $0.name) }
    }

    func defaultResult() async -> PetEntity? {
        try? await suggestedEntities().first
    }
}

